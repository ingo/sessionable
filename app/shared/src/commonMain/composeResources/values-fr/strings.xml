    <string name="tour_1_title">Gardez ce que vous voulez voir</string>
    <string name="tour_1_text">Parcourez l’onglet Programme et touchez le marque-page d’une session. Vos favoris remplissent votre calendrier.</string>
    <string name="tour_2_title">Votre journée en un coup d’œil</string>
    <string name="tour_2_text">Maintenant montre ce qui se passe et la suite. Calendrier montre toute votre journée, signale les chevauchements et propose des sessions pour le temps libre.</string>
    <string name="tour_3_title">Notes, évaluations et photos</string>
    <string name="tour_3_text">Ouvrez une session pour ajouter des notes, une évaluation, des photos ou des diapositives. Notez les intervenants que vous rencontrez.</string>
